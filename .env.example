SSS_CATALOG_PATH=data/catalog/catalog.sqlite
SSS_RUNTIME_PATH=data/runtime/state.sqlite
# Enable only after approval to send user queries to the selected provider.
SSS_ENABLE_EXTERNAL_LLM=0
SSS_LLM_PROVIDER=yandex
OPENAI_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-5.1
SSS_LLM_MODEL=gpt-5.4-mini-2026-03-17
# Per-request interpreter budget. Two calls allow interpretation and expert planning.
LLM_TIMEOUT_SECONDS=18
LLM_MAX_CALLS_PER_REQUEST=2
# Use matching tariff overrides together for a different tariff or model.
SSS_LLM_INPUT_PER_MILLION=
SSS_LLM_CACHED_INPUT_PER_MILLION=
SSS_LLM_OUTPUT_PER_MILLION=
SSS_LLM_PRICING_VERSION=
SSS_DEMO_MODE=0
